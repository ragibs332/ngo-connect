# Server Environment Configuration
PORT=5000
NODE_ENV=production

# JWT Authentication Secret Key
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# Initial Platform Administrator Credentials
ADMIN_NAME=Platform Administrator
ADMIN_EMAIL=admin@ngoconnect.org
ADMIN_PASSWORD=Admin@SecurePass2026!

# Database Configuration (Optional MongoDB URI for external cloud DB)
# If omitted, NGO Connect uses high-performance persistent JSON storage
# MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/ngoconnect?retryWrites=true&w=majority

# AI Chatbot API Key (Optional for Gemini generative expansion)
# GEMINI_API_KEY=your_gemini_api_key_here
